# Copie para .env e ajuste. O .env é ignorado pelo git.

# Banco
DATABASE_URL=postgres://habito:habito_dev@localhost:5432/controle_habito

# Usuário único do app (ver Docs/mapas/Mapa de autenticação.md)
# APP_USUARIO_NOME só aparece na saudação do dashboard.
APP_USUARIO_NOME=Tiago
# Semeia credencial_senha no primeiro db:seed. Depois do cadastro da biometria
# a senha é desativada e esta variável deixa de ter função.
APP_SENHA_INICIAL=troque-esta-senha

# Domínio das passkeys. Em desenvolvimento, WebAuthn só funciona em localhost
# ou HTTPS. Em produção este valor é IMUTÁVEL: mudar invalida a biometria.
RP_ID=localhost
RP_NAME=Controle de Hábitos

# Preenchidas na etapa 5 (deploy) com as chaves VAPID geradas para o push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:troque@exemplo.com
