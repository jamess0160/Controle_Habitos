# Copie para .env e ajuste. O .env é ignorado pelo git.

# Banco
DATABASE_URL=postgres://habito:habito_dev@localhost:5432/controle_habito

# Banco dos testes de integração. Opcional: sem ela, os testes usam o mesmo
# servidor com "_test" no fim do nome do database, criado e migrado por eles.
# DATABASE_URL_TEST=

# Ambiente. Dois valores: desenvolvimento | producao.
#
# Em desenvolvimento a senha CONTINUA ATIVA ao lado da passkey, e é ela que dá
# entrada num desktop sem autenticador. Em produção a senha é desativada no
# cadastro da biometria e a passkey passa a ser o único acesso.
#
# Falha fechada: ausente, vazia ou com qualquer outro valor significa produção.
# Nunca deixe "desenvolvimento" no .env do servidor exposto na internet — seria
# uma porta a mais, para sempre. A tela de login avisa quando está nesse modo.
APP_MODO=producao

# Usuário único do app (ver Docs/mapas/Mapa de autenticação.md)
# APP_USUARIO_NOME só aparece na saudação do dashboard.
APP_USUARIO_NOME=Tiago
# Semeia credencial_senha no primeiro db:seed. Depois do cadastro da biometria
# a senha é desativada e esta variável deixa de ter função.
APP_SENHA_INICIAL=troque-esta-senha

# Domínio das passkeys. Em desenvolvimento, WebAuthn só funciona em localhost
# ou HTTPS. Em produção este valor é IMUTÁVEL: mudar invalida a biometria.
RP_ID=localhost
RP_NAME=Controle de Hábitos

# Chaves VAPID do Web Push. Gere o par com:
#
#   npm run push:chaves
#
# São a identidade do remetente perante o serviço de push. Trocá-las invalida
# toda assinatura existente — o navegador assina PARA uma chave pública, e um
# envio assinado por outra é recusado. O par é lido do banco (config_app), onde
# o seed o grava sem sobrescrever; estas variáveis só o semeiam.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contato do remetente, exigido pelo VAPID e enviado ao serviço de push a cada
# envio. Aceita mailto: ou https://. Vazio = derivado de RP_ID como
# https://<dominio>, que é o que vale quando o túnel da etapa 5 estiver de pé.
VAPID_SUBJECT=
