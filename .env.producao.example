# Variáveis do compose de produção. Copie para `.env` NO SERVIDOR, ao lado do
# docker-compose.yml, e preencha. O `.env` é ignorado pelo git.
#
# Este arquivo e o `.env.example` não se misturam: aquele é a máquina de
# desenvolvimento (Postgres em localhost, APP_MODO=desenvolvimento, RP_ID=localhost),
# este é o servidor. Copiar o de desenvolvimento para cá deixaria a senha
# funcionando para sempre ao lado da passkey — uma porta a mais, permanente.

# ─── Banco ───────────────────────────────────────────────────────────────────
# A senha do Postgres. Gere com:  openssl rand -hex 32
#
# Só caracteres seguros em URL: o compose MONTA a DATABASE_URL a partir desta
# variável (postgres://usuario:senha@postgres:5432/banco), e `@`, `:`, `/` ou `#`
# dentro dela quebrariam a URL. Hex resolve.
#
# NÃO defina DATABASE_URL aqui. Ela é montada pelo compose, para a senha existir
# num lugar só — duas cópias de uma senha é uma cópia que vai divergir.
POSTGRES_PASSWORD=

# Opcionais; os padrões do compose são estes mesmos.
# POSTGRES_USER=habito
# POSTGRES_DB=controle_habito

# ─── Ambiente ────────────────────────────────────────────────────────────────
# NO SERVIDOR ISTO FICA `producao`, SEMPRE.
#
# Em `desenvolvimento` a senha continua ativa ao lado da passkey — é a porta de
# entrada num desktop sem autenticador, e na internet seria uma porta a mais,
# para sempre. Falha fechada: só a palavra exata liga o modo frouxo, qualquer
# outro valor (ou nenhum) é produção. A tela de login avisa em bloco visível
# quando está no modo frouxo; se esse aviso aparecer no celular, esta linha está
# errada.
APP_MODO=producao

# Aparece só na saudação do dashboard.
APP_USUARIO_NOME=Tiago

# A senha do PRIMEIRO acesso, semeada na primeira subida e só nela. Depois do
# cadastro da biometria ela é desativada e esta variável não tem mais função —
# o seed nunca sobrescreve uma credencial existente.
#
# Gere uma que não seja usada em outro lugar:  openssl rand -base64 18
APP_SENHA_INICIAL=

# ─── Domínio ─────────────────────────────────────────────────────────────────
# O hostname pelo qual o app é acessado, sem esquema e sem barra.
#
# É o RP ID das passkeys, e é IMUTÁVEL na prática: o navegador guarda a
# credencial amarrada a este domínio, e trocá-lo invalida a biometria
# cadastrada. O valor é gravado em `config_app` na primeira subida e a partir daí
# o banco manda — editar esta linha depois NÃO muda nada (o seed usa ON CONFLICT
# DO NOTHING, de propósito). Trocar de domínio é o procedimento descrito em
# Docs/Deploy.md.
#
# Vazio aqui de propósito, e não com um domínio de exemplo: um valor plausível
# seria gravado em `config_app` na primeira subida e só apareceria como erro no
# celular, no cadastro da passkey, com a saída sendo um UPDATE à mão na tabela.
# Vazio, o seed não grava linha nenhuma e o app recusa o cadastro com
# "O domínio das passkeys não está configurado no servidor (RP_ID)" — o mesmo
# erro, mas consertável preenchendo esta linha e re-semeando.
RP_ID=
RP_NAME=Controle de Hábitos

# ─── Web Push ────────────────────────────────────────────────────────────────
# Gere o par UMA vez, antes da primeira subida:
#
#   docker compose run --rm --no-deps worker tsx cli/vapid.ts
#
# Trocá-lo depois invalida toda assinatura existente — o navegador assina PARA
# uma chave pública, e um envio assinado por outra é recusado. O par vai para
# `config_app` no seed (também ON CONFLICT DO NOTHING) e é lá que o envio o lê.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contato do remetente, exigido pelo VAPID. Vazio = derivado do RP_ID como
# https://<dominio>, que é a resposta certa num app de um usuário só.
VAPID_SUBJECT=

# ─── Túnel: nada aqui ────────────────────────────────────────────────────────
# Não há `TUNNEL_TOKEN`, e a ausência é a decisão. O túnel é o cloudflared que
# já roda no homelab administrando as rotas da conta; esta pilha não sobe um
# segundo. O que ela faz é expor a rede `controle-habito-borda`, onde aquele
# contêiner entra para alcançar `http://app:3000` — ver o bloco `networks` do
# docker-compose.yml e o passo 2 de Docs/Deploy.md.
#
# O token, portanto, vive na configuração do cloudflared e não aqui. Um dump
# deste banco ou uma cópia deste arquivo não carrega credencial de túnel.

# ─── Host ────────────────────────────────────────────────────────────────────
# Fuso dos contêineres. Não muda o comportamento do app — a virada das 04:00 usa
# o fuso de `config_app` pelo `Intl`, justamente para não herdar o do processo.
# O que isto muda é o carimbo de hora do `docker logs`.
TZ=America/Sao_Paulo

# Onde os dumps do pg_dump ficam no host. O compose monta este diretório em
# /backups dentro do contêiner do Postgres, e infra/backup.sh lê a mesma
# variável. Mudar num lugar só faria o script contar arquivos num diretório e o
# Postgres escrever em outro.
HABITO_BACKUP_DIR=/var/backups/controle-habito
# Dias de retenção. A retenção nunca apaga os 4 dumps mais novos, vencidos ou não.
HABITO_BACKUP_RETENCAO=30
